<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pantry Panic</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f6f7f8;
            color: #222;
        }

        header {
            background: white;
            border-bottom: 1px solid #ddd;
            padding: 18px 40px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            margin: 0;
            font-size: 28px;
        }

        nav button {
            background: none;
            border: none;
            margin-left: 18px;
            font-size: 15px;
            cursor: pointer;
        }

        nav button:hover {
            text-decoration: underline;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 35px auto;
        }

        .top-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .top-section h2 {
            margin-bottom: 5px;
        }

        .top-section p {
            color: #666;
            margin-top: 0;
        }

        .add-button {
            border: none;
            border-radius: 8px;
            padding: 12px 18px;
            font-size: 16px;
            cursor: pointer;
            background: #222;
            color: white;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 30px;
        }

        .summary-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

        .summary-card h3 {
            margin: 0;
            font-size: 14px;
            color: #666;
        }

        .summary-number {
            font-size: 32px;
            font-weight: bold;
            margin-top: 8px;
        }

        .section {
            margin-bottom: 30px;
        }

        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title h2 {
            margin-bottom: 8px;
        }

        .food-list {
            display: grid;
            gap: 12px;
        }

        .food-card {
            background: white;
            padding: 16px 18px;
            border-radius: 10px;
            box-shadow: 0 2px 7px rgba(0,0,0,0.05);

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .food-info h3 {
            margin: 0 0 5px 0;
        }

        .food-info p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }

        .expiration-badge {
            padding: 7px 12px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
        }

        .expired {
            background: #ffd6d6;
            color: #990000;
        }

        .today {
            background: #ffe1b8;
            color: #8a4b00;
        }

        .soon {
            background: #fff3b8;
            color: #765d00;
        }

        .fresh {
            background: #dff4df;
            color: #176b17;
        }

        .food-actions {
            margin-left: 20px;
        }

        .food-actions button {
            margin-left: 6px;
            border: none;
            border-radius: 6px;
            padding: 7px 10px;
            cursor: pointer;
        }

        .edit-button {
            background: #e8e8e8;
        }

        .delete-button {
            background: #ffe0e0;
        }

        .empty-message {
            background: white;
            padding: 20px;
            border-radius: 10px;
            color: #777;
        }

        .modal-background {
            display: none;
            position: fixed;
            top: 0;
            left: 0;

            width: 100%;
            height: 100%;

            background: rgba(0,0,0,0.45);

            justify-content: center;
            align-items: center;
        }

        .modal {
            background: white;
            width: 90%;
            max-width: 450px;

            padding: 25px;
            border-radius: 12px;
        }

        .modal h2 {
            margin-top: 0;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .modal-buttons button {
            padding: 10px 14px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }

        .cancel-button {
            background: #ddd;
        }

        .save-button {
            background: #222;
            color: white;
        }

        @media(max-width: 800px) {

            .summary-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            header {
                flex-direction: column;
                gap: 12px;
            }

            .top-section {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media(max-width: 500px) {

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .food-card {
                align-items: flex-start;
                flex-direction: column;
                gap: 15px;
            }

            .food-actions {
                margin-left: 0;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>Pantry Panic</h1>

    <nav>
        <button>Home</button>
        <button>Inventory</button>
        <button>Grocery List</button>
        <button>Recipes</button>
    </nav>
</header>


<div class="container">

    <div class="top-section">

        <div>
            <h2>Your Food Expiration Dashboard</h2>
            <p>
                Keep track of what needs to be eaten before it goes bad.
            </p>
        </div>

        <button class="add-button" onclick="openModal()">
            + Add Food
        </button>

    </div>


    <!-- SUMMARY CARDS -->

    <div class="summary-grid">

        <div class="summary-card">
            <h3>Expired</h3>
            <div class="summary-number" id="expiredCount">0</div>
        </div>

        <div class="summary-card">
            <h3>Expires Today</h3>
            <div class="summary-number" id="todayCount">0</div>
        </div>

        <div class="summary-card">
            <h3>Expires Soon</h3>
            <div class="summary-number" id="soonCount">0</div>
        </div>

        <div class="summary-card">
            <h3>Total Items</h3>
            <div class="summary-number" id="totalCount">0</div>
        </div>

    </div>


    <!-- EXPIRED -->

    <div class="section">
        <div class="section-title">
            <h2>Expired</h2>
        </div>

        <div class="food-list" id="expiredList"></div>
    </div>


    <!-- TODAY -->

    <div class="section">
        <div class="section-title">
            <h2>Expires Today</h2>
        </div>

        <div class="food-list" id="todayList"></div>
    </div>


    <!-- SOON -->

    <div class="section">
        <div class="section-title">
            <h2>Use Soon</h2>
        </div>

        <div class="food-list" id="soonList"></div>
    </div>


    <!-- LATER -->

    <div class="section">
        <div class="section-title">
            <h2>Good for Later</h2>
        </div>

        <div class="food-list" id="laterList"></div>
    </div>

</div>



<!-- ADD FOOD MODAL -->

<div class="modal-background" id="modalBackground">

    <div class="modal">

        <h2 id="modalTitle">Add Food</h2>

        <div class="form-group">

            <label>Food Name</label>

            <input
                type="text"
                id="foodName"
                placeholder="Example: Milk"
            >

        </div>


        <div class="form-group">

            <label>Category</label>

            <select id="foodCategory">

                <option>Dairy</option>
                <option>Fruit</option>
                <option>Vegetable</option>
                <option>Meat</option>
                <option>Frozen</option>
                <option>Pantry</option>
                <option>Other</option>

            </select>

        </div>


        <div class="form-group">

            <label>Expiration Date</label>

            <input
                type="date"
                id="expirationDate"
            >

        </div>


        <div class="modal-buttons">

            <button
                class="cancel-button"
                onclick="closeModal()"
            >
                Cancel
            </button>

            <button
                class="save-button"
                onclick="saveFood()"
            >
                Save
            </button>

        </div>

    </div>

</div>



<script>

    /*
    ----------------------------------------------------
    FOOD DATA
    ----------------------------------------------------
    */

    let inventory = [

        {
            id: 1,
            name: "Milk",
            category: "Dairy",
            expirationDate: getDateFromToday(0)
        },

        {
            id: 2,
            name: "Spinach",
            category: "Vegetable",
            expirationDate: getDateFromToday(1)
        },

        {
            id: 3,
            name: "Chicken",
            category: "Meat",
            expirationDate: getDateFromToday(3)
        },

        {
            id: 4,
            name: "Eggs",
            category: "Dairy",
            expirationDate: getDateFromToday(9)
        },

        {
            id: 5,
            name: "Yogurt",
            category: "Dairy",
            expirationDate: getDateFromToday(-1)
        }

    ];


    let editingFoodId = null;



    /*
    ----------------------------------------------------
    DATE FUNCTIONS
    ----------------------------------------------------
    */


    function getDateFromToday(daysFromNow) {

        const date = new Date();

        date.setDate(
            date.getDate() + daysFromNow
        );

        return date
            .toISOString()
            .split("T")[0];

    }



    function getDaysUntilExpiration(expirationDate) {

        const today = new Date();

        today.setHours(0, 0, 0, 0);


        const expiration =
            new Date(expirationDate + "T00:00:00");


        const difference =
            expiration - today;


        return Math.round(
            difference / (1000 * 60 * 60 * 24)
        );

    }



    /*
    ----------------------------------------------------
    DETERMINE EXPIRATION STATUS
    ----------------------------------------------------
    */


    function getStatus(daysLeft) {

        if (daysLeft < 0) {

            return "expired";

        }

        if (daysLeft === 0) {

            return "today";

        }

        if (daysLeft <= 5) {

            return "soon";

        }

        return "fresh";

    }



    /*
    ----------------------------------------------------
    FORMAT EXPIRATION TEXT
    ----------------------------------------------------
    */


    function getExpirationText(daysLeft) {

        if (daysLeft < 0) {

            return (
                "Expired " +
                Math.abs(daysLeft) +
                " day(s) ago"
            );

        }

        if (daysLeft === 0) {

            return "Expires today";

        }

        if (daysLeft === 1) {

            return "Expires tomorrow";

        }

        return (
            "Expires in " +
            daysLeft +
            " days"
        );

    }



    /*
    ----------------------------------------------------
    DISPLAY EVERYTHING
    ----------------------------------------------------
    */


    function displayInventory() {

        const expiredList =
            document.getElementById("expiredList");

        const todayList =
            document.getElementById("todayList");

        const soonList =
            document.getElementById("soonList");

        const laterList =
            document.getElementById("laterList");


        expiredList.innerHTML = "";
        todayList.innerHTML = "";
        soonList.innerHTML = "";
        laterList.innerHTML = "";


        /*
        Sort by expiration date.
        Earliest expiration appears first.
        */

        inventory.sort((a, b) => {

            return (
                new Date(a.expirationDate) -
                new Date(b.expirationDate)
            );

        });



        let expiredCount = 0;
        let todayCount = 0;
        let soonCount = 0;



        inventory.forEach(food => {

            const daysLeft =
                getDaysUntilExpiration(
                    food.expirationDate
                );


            const status =
                getStatus(daysLeft);


            const card =
                createFoodCard(
                    food,
                    daysLeft,
                    status
                );


            if (status === "expired") {

                expiredList.appendChild(card);

                expiredCount++;

            }

            else if (status === "today") {

                todayList.appendChild(card);

                todayCount++;

            }

            else if (status === "soon") {

                soonList.appendChild(card);

                soonCount++;

            }

            else {

                laterList.appendChild(card);

            }

        });



        /*
        If a category has nothing,
        show an empty message.
        */

        addEmptyMessageIfNeeded(
            expiredList,
            "No expired food."
        );

        addEmptyMessageIfNeeded(
            todayList,
            "Nothing expires today."
        );

        addEmptyMessageIfNeeded(
            soonList,
            "Nothing expires in the next 5 days."
        );

        addEmptyMessageIfNeeded(
            laterList,
            "No other food currently stored."
        );



        /*
        Update dashboard numbers
        */

        document.getElementById(
            "expiredCount"
        ).innerText =
            expiredCount;


        document.getElementById(
            "todayCount"
        ).innerText =
            todayCount;


        document.getElementById(
            "soonCount"
        ).innerText =
            soonCount;


        document.getElementById(
            "totalCount"
        ).innerText =
            inventory.length;



        /*
        Save the data so it remains
        after browser refresh.
        */

        saveInventory();

    }



    /*
    ----------------------------------------------------
    CREATE ONE FOOD CARD
    ----------------------------------------------------
    */


    function createFoodCard(
        food,
        daysLeft,
        status
    ) {

        const card =
            document.createElement("div");


        card.className =
            "food-card";


        card.innerHTML = `

            <div class="food-info">

                <h3>
                    ${food.name}
                </h3>

                <p>
                    ${food.category}
                    •
                    ${formatDate(food.expirationDate)}
                </p>

            </div>


            <div>

                <span
                    class="expiration-badge ${status}"
                >

                    ${getExpirationText(daysLeft)}

                </span>


                <span class="food-actions">

                    <button
                        class="edit-button"
                        onclick="editFood(${food.id})"
                    >
                        Edit
                    </button>


                    <button
                        class="delete-button"
                        onclick="deleteFood(${food.id})"
                    >
                        Delete
                    </button>

                </span>

            </div>

        `;


        return card;

    }



    /*
    ----------------------------------------------------
    EMPTY SECTION MESSAGE
    ----------------------------------------------------
    */


    function addEmptyMessageIfNeeded(
        list,
        message
    ) {

        if (list.children.length === 0) {

            const emptyMessage =
                document.createElement("div");


            emptyMessage.className =
                "empty-message";


            emptyMessage.innerText =
                message;


            list.appendChild(
                emptyMessage
            );

        }

    }



    /*
    ----------------------------------------------------
    FORMAT DATE
    ----------------------------------------------------
    */


    function formatDate(dateString) {

        const date =
            new Date(
                dateString +
                "T00:00:00"
            );


        return date.toLocaleDateString(
            "en-US",
            {
                month: "short",
                day: "numeric",
                year: "numeric"
            }
        );

    }



    /*
    ----------------------------------------------------
    OPEN ADD FOOD MODAL
    ----------------------------------------------------
    */


    function openModal() {

        editingFoodId = null;


        document.getElementById(
            "modalTitle"
        ).innerText =
            "Add Food";


        document.getElementById(
            "foodName"
        ).value =
            "";


        document.getElementById(
            "foodCategory"
        ).value =
            "Dairy";


        document.getElementById(
            "expirationDate"
        ).value =
            "";


        document.getElementById(
            "modalBackground"
        ).style.display =
            "flex";

    }



    /*
    ----------------------------------------------------
    CLOSE MODAL
    ----------------------------------------------------
    */


    function closeModal() {

        document.getElementById(
            "modalBackground"
        ).style.display =
            "none";

    }



    /*
    ----------------------------------------------------
    SAVE FOOD
    ----------------------------------------------------
    */


    function saveFood() {

        const name =
            document
                .getElementById("foodName")
                .value
                .trim();


        const category =
            document
                .getElementById("foodCategory")
                .value;


        const expirationDate =
            document
                .getElementById("expirationDate")
                .value;



        if (
            name === "" ||
            expirationDate === ""
        ) {

            alert(
                "Please enter a food name and expiration date."
            );

            return;

        }



        /*
        Editing an existing food item
        */

        if (editingFoodId !== null) {

            const food =
                inventory.find(
                    item =>
                        item.id === editingFoodId
                );


            food.name =
                name;

            food.category =
                category;

            food.expirationDate =
                expirationDate;

        }


        /*
        Adding new food
        */

        else {

            const newFood = {

                id: Date.now(),

                name: name,

                category: category,

                expirationDate:
                    expirationDate

            };


            inventory.push(
                newFood
            );

        }


        closeModal();

        displayInventory();

    }



    /*
    ----------------------------------------------------
    EDIT FOOD
    ----------------------------------------------------
    */


    function editFood(id) {

        const food =
            inventory.find(
                item =>
                    item.id === id
            );


        if (!food) {

            return;

        }


        editingFoodId =
            id;


        document.getElementById(
            "modalTitle"
        ).innerText =
            "Edit Food";


        document.getElementById(
            "foodName"
        ).value =
            food.name;


        document.getElementById(
            "foodCategory"
        ).value =
            food.category;


        document.getElementById(
            "expirationDate"
        ).value =
            food.expirationDate;


        document.getElementById(
            "modalBackground"
        ).style.display =
            "flex";

    }



    /*
    ----------------------------------------------------
    DELETE FOOD
    ----------------------------------------------------
    */


    function deleteFood(id) {

        const food =
            inventory.find(
                item =>
                    item.id === id
            );


        if (!food) {

            return;

        }


        const confirmed =
            confirm(
                "Remove " +
                food.name +
                " from your inventory?"
            );


        if (!confirmed) {

            return;

        }


        inventory =
            inventory.filter(
                item =>
                    item.id !== id
            );


        displayInventory();

    }



    /*
    ----------------------------------------------------
    LOCAL STORAGE
    ----------------------------------------------------

    LocalStorage keeps the food inventory
    saved in the user's browser.
    ----------------------------------------------------
    */


    function saveInventory() {

        localStorage.setItem(
            "pantryPanicInventory",
            JSON.stringify(inventory)
        );

    }



    function loadInventory() {

        const savedInventory =
            localStorage.getItem(
                "pantryPanicInventory"
            );


        if (savedInventory) {

            inventory =
                JSON.parse(
                    savedInventory
                );

        }

    }



    /*
    ----------------------------------------------------
    INITIALIZE APP
    ----------------------------------------------------
    */


    loadInventory();

    displayInventory();

</script>

</body>
</html>
